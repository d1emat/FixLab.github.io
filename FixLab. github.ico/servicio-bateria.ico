<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cambio de batería | FixLab</title>
  <link rel="icon" type="image/png" href="Fotos/FixLab_Logo.png">
  <link rel="stylesheet" href="styles.css?v=6">
</head>
<body>
  <header class="site-header">
    <nav class="container nav">
      <a class="brand" href="index.html"><img src="Fotos/FixLab_Logo.png" alt="FixLab" class="brand-logo"></a>
      <button id="menuToggle" class="menu-toggle">Menú</button>
      <ul id="navLinks" class="nav-links">
        <li><a href="index.html">Inicio</a></li>
        <li><a href="servicios.html" class="active">Servicios</a></li>
        <li><a href="tiendas.html">Tiendas</a></li>
        <li><a href="tienda.html">Tienda</a></li>
        <li><a href="contacto.html">Contacto</a></li>
      </ul>
      <a class="btn" href="login.html">Iniciar sesión</a>
    </nav>
  </header>
  <main class="page-main">
    <section class="section">
      <div class="container">
        <p><a class="btn btn-secondary" href="servicios.html">← Volver</a></p>
        <div class="product-detail">
          <div class="product-gallery">
            <img src="Fotos servicios/cambio_bateria.png" alt="Cambio de batería" class="product-main-image">
          </div>
          <article class="card">
            <h1>Cambio de batería</h1>
            <p class="section-subtitle">Baterías de alto rendimiento para mayor autonomía.</p>
            <p class="price-tag">Desde 49€</p>
            <p>Sustitución con revisión de ciclos y rendimiento en carga.</p>
            <p>Tiempo estimado: 30 a 60 minutos.</p>
            <p>Test final de consumo energético.</p>
            <a href="reserva.html?service=Bateria" class="booking-btn">📅 Reservar ahora</a>
          </article>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container">
      <nav class="footer-links">
        <a href="index.html">Inicio</a><a href="servicios.html">Servicios</a><a href="tiendas.html">Tiendas</a><a href="tienda.html">Tienda</a><a href="aviso-legal.html">Legal</a>
      </nav>
      <p>© <span id="year"></span> FixLab</p>
    </div>
  </footer>
  <script src="script.js"></script>
</body>
</html>