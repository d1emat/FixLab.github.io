<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reparación de pantalla | FixLab</title>
  <link rel="icon" type="image/png" href="Fotos/FixLab_Logo.png">
  <link rel="stylesheet" href="styles.css?v=6">
</head>
<body>
  <header class="site-header">
    <nav class="container nav">
      <a class="brand" href="index.html"><img src="Fotos/FixLab_Logo.png" alt="FixLab" class="brand-logo"></a>
      <button id="menuToggle" class="menu-toggle">Menú</button>
      <ul id="navLinks" class="nav-links">
        <li><a href="index.html">Inicio</a></li>
        <li><a href="servicios.html" class="active">Servicios</a></li>
        <li><a href="tiendas.html">Tiendas</a></li>
        <li><a href="tienda.html">Tienda</a></li>
        <li><a href="contacto.html">Contacto</a></li>
      </ul>
      <a class="btn" href="login.html">Iniciar sesión</a>
    </nav>
  </header>
  <main class="page-main">
    <section class="section">
      <div class="container">
        <p><a class="btn btn-secondary" href="servicios.html">← Volver</a></p>
        <div class="product-detail">
          <div class="product-gallery">
            <img src="Fotos servicios/reparacion_pantalla.png" alt="Reparación de pantalla" class="product-main-image">
          </div>
          <article class="card">
            <h1>Reparación de pantalla</h1>
            <p class="section-subtitle">Sustitución de pantalla rota o táctil sin respuesta.</p>
            <p class="price-tag">Desde 69€</p>
            <p>Cambio completo de módulo LCD/OLED, calibración de brillo y test táctil.</p>
            <p>Tiempo estimado: 45 a 90 minutos.</p>
            <p>Garantía de 3 meses.</p>
            <a href="reserva.html?service=Pantalla" class="booking-btn">📅 Reservar ahora</a>
          </article>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container">
      <nav class="footer-links">
        <a href="index.html">Inicio</a><a href="servicios.html">Servicios</a><a href="tiendas.html">Tiendas</a><a href="tienda.html">Tienda</a><a href="aviso-legal.html">Legal</a>
      </nav>
      <p>© <span id="year"></span> FixLab</p>
    </div>
  </footer>
  <script src="script.js"></script>
</body>
